#!/usr/bin/env bash
# MCP host bootstrap, rendered by Terraform (the one legitimately templated
# file — user_data needs region/prefix). Shell expansion is escaped so it
# survives templating. Files come from the git checkout, secrets from SSM;
# nothing sensitive is baked into user_data.
set -euo pipefail

REGION="${region}"
PREFIX="${path_prefix}"
APP_DIR="/opt/mcp"
DATA_DEV="/dev/nvme1n1" # the attached EBS data volume (Nitro naming)

# --- SSM agent (present on standard AL2023; ensure it is up for debugging) ---
systemctl enable --now amazon-ssm-agent || true

# --- Docker + compose + buildx plugins + git ---------------------------------
dnf install -y docker git
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-aarch64" \
	-o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
# buildx: docker compose build needs >= 0.17, but AL2023 ships 0.12, so pin one
curl -fsSL "https://github.com/docker/buildx/releases/download/v0.19.0/buildx-v0.19.0.linux-arm64" \
	-o /usr/local/lib/docker/cli-plugins/docker-buildx
chmod +x /usr/local/lib/docker/cli-plugins/docker-buildx

# --- Repo checkout (file delivery) -------------------------------------------
# The app dir IS a clone of the platform repo (public, anonymous https);
# `make deploy` advances it with fetch + reset --hard. Must precede the data
# mount (clone needs a nonexistent/empty target).
git clone https://github.com/nickawilliams/mcp.git "$${APP_DIR}"

# --- Persistent data volume (format once, then mount) ------------------------
# data/ is gitignored: untracked runtime content alongside the checkout.
if ! blkid "$${DATA_DEV}" >/dev/null 2>&1; then
	mkfs.ext4 -L mcp-data "$${DATA_DEV}"
fi
grep -q "$${APP_DIR}/data" /etc/fstab ||
	echo "LABEL=mcp-data $${APP_DIR}/data ext4 defaults,nofail 0 2" >>/etc/fstab
mkdir -p "$${APP_DIR}/data"
mount "$${APP_DIR}/data"

# --- Sync secrets + launch ---------------------------------------------------
# Delegated to the tracked refresh script — the same one `make deploy` runs,
# so first boot and every later deploy are one mechanism.
MCP_REGION="$${REGION}" MCP_PREFIX="$${PREFIX}" \
	bash "$${APP_DIR}/scripts/refresh.sh"
