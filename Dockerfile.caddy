# Caddy with the Route53 DNS plugin (DNS-01 ACME for the wildcard via the
# EC2 instance role — no static AWS keys on the box) and caddy-jwt (offline
# validation of auth.nickawilliams.com access tokens against its JWKS; the
# OAuth half of the dual-auth vhosts in caddy/Caddyfile).
FROM caddy:2-builder AS builder
RUN xcaddy build \
	--with github.com/caddy-dns/route53 \
	--with github.com/ggicci/caddy-jwt

FROM caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
