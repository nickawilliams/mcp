# Tracked literal config, delivered via the host's git checkout and mounted
# at /etc/caddy. Bearer tokens arrive as caddy-container environment
# variables (MCP_TOKEN_<SERVICE>, fanned out of the host .env by
# docker-compose) and substitute textually at Caddyfile parse time ({$VAR}),
# so a token rotation lands on the next compose reconcile + caddy reload.
#
# Auth is dual-path per service (ROADMAP C4, landed 2026-08-07):
#   - static bearer: the machine credential (scripts/CI/debug) — validated
#     locally by string compare, zero runtime dependencies.
#   - OAuth 2.1: interactive MCP clients (Claude Code/Desktop, ChatGPT,
#     Codex) discover the authorization server via the RFC 9728 metadata
#     below, register dynamically, and present RS256 at+jwt access tokens
#     minted by auth.nickawilliams.com (the infrastructure repo's Auth0
#     tenant), verified offline against its JWKS — no per-request calls to
#     the IdP. Audience = the service URL (matches each service's
#     auth0_resource_server identifier in terraform).

{
	# jwtauth (ggicci/caddy-jwt, built into Dockerfile.caddy) is an auth
	# handler; slot it where basicauth would run.
	order jwtauth before basicauth
}

# One wildcard cert for *.mcp.nickawilliams.com via Route53 DNS-01 (keeps
# individual service names out of Certificate Transparency logs). Per-service
# routing is by host matcher. +1 service = +1 vhost block (its MCP_TOKEN_*
# env line in compose, and its audience in the module's terraform).
*.mcp.nickawilliams.com {
	tls {
		dns route53
	}

	# Structured access log to stdout (docker logs): a timestamped audit
	# trail of every request and 401 across all vhosts.
	log {
		output stdout
		format json
	}

	@graphiti host graphiti.mcp.nickawilliams.com
	handle @graphiti {
		# RFC 9728 protected-resource metadata — unauthenticated by design:
		# clients read it to find the authorization server before they have
		# any token. `resource` must equal the terraform identifier exactly
		# (clients echo it as the RFC 8707 resource param). `scopes_supported`
		# drives the scopes clients request (the MCP SDK copies it into the
		# authorize scope param) — without offline_access here, clients send
		# no scope at all and Auth0 never issues a refresh token.
		handle /.well-known/oauth-protected-resource {
			header Content-Type application/json
			respond `{"resource":"https://graphiti.mcp.nickawilliams.com","authorization_servers":["https://auth.nickawilliams.com/"],"bearer_methods_supported":["header"],"scopes_supported":["offline_access"]}` 200
		}

		# Machine path: static bearer, validated locally.
		@graphiti-bearer header Authorization "Bearer {$MCP_TOKEN_GRAPHITI}"
		handle @graphiti-bearer {
			# The bare hostname IS the endpoint: map / onto the upstream's
			# MCP path, and collapse the trailing-slash variant that would
			# otherwise 307-redirect (with an http:// Location) at the
			# upstream.
			rewrite / /mcp
			rewrite /mcp/ /mcp
			# Some upstreams (the MCP SDK's DNS-rebinding guard) only accept
			# a localhost Host, so present one matching the upstream's port.
			reverse_proxy graphiti-mcp:8000 {
				header_up Host localhost:8000
			}
		}

		# OAuth path: everything else must carry a valid Auth0 JWT.
		# Failures 401 into handle_errors below, which adds the discovery
		# pointer.
		handle {
			jwtauth {
				jwk_url https://auth.nickawilliams.com/.well-known/jwks.json
				issuer_whitelist https://auth.nickawilliams.com/
				# Both canonical forms of the bare origin: claude.ai/ChatGPT
				# request the audience verbatim (no slash), Claude Code sends
				# the WHATWG-normalized form (trailing slash). One resource
				# server per form exists in terraform.
				audience_whitelist https://graphiti.mcp.nickawilliams.com https://graphiti.mcp.nickawilliams.com/
			}
			rewrite / /mcp
			rewrite /mcp/ /mcp
			reverse_proxy graphiti-mcp:8000 {
				header_up Host localhost:8000
			}
		}
	}

	@mail host mail.mcp.nickawilliams.com
	handle @mail {
		handle /.well-known/oauth-protected-resource {
			header Content-Type application/json
			respond `{"resource":"https://mail.mcp.nickawilliams.com","authorization_servers":["https://auth.nickawilliams.com/"],"bearer_methods_supported":["header"],"scopes_supported":["offline_access"]}` 200
		}

		# No 400→404 session translation here (cf. the ebay block): the mail
		# bridge runs stateless, so it issues no Mcp-Session-Id and has no
		# session that can be evicted. Its transport-level 400s are now only
		# genuinely malformed requests, and reporting those as "session not
		# found" would send clients into a pointless re-initialize.
		#
		# Stateless also means GET returns 405 (the spec's answer when a
		# server offers no SSE stream); clients must fall back to POST-only,
		# which is what the claude.ai connector already does.
		@mail-bearer header Authorization "Bearer {$MCP_TOKEN_MAIL}"
		handle @mail-bearer {
			rewrite / /mcp
			rewrite /mcp/ /mcp
			reverse_proxy mail-mcp:8080 {
				header_up Host localhost:8080
			}
		}

		handle {
			jwtauth {
				jwk_url https://auth.nickawilliams.com/.well-known/jwks.json
				issuer_whitelist https://auth.nickawilliams.com/
				# Both canonical forms — see the graphiti block above.
				audience_whitelist https://mail.mcp.nickawilliams.com https://mail.mcp.nickawilliams.com/
			}
			rewrite / /mcp
			rewrite /mcp/ /mcp
			reverse_proxy mail-mcp:8080 {
				header_up Host localhost:8080
			}
		}
	}

	@ebay host ebay.mcp.nickawilliams.com
	handle @ebay {
		# TEMPORARY (2026-08-22): `resource` carries the trailing slash here
		# and nowhere else — a deliberate probe, not drift. Claude Code always
		# requests the WHATWG-normalized (slashed) audience while
		# claude.ai/ChatGPT request the bare form, which is the only reason
		# every service carries two resource servers. Open question: does
		# claude.ai take its audience from this field, or from its own
		# configured connector URL? Read the next token exchange: a slashed
		# audience means this field drives it, graphiti and mail can follow,
		# and six resource servers collapse to three. A bare one means the
		# client config drives it — revert this block and converge by putting
		# the slash in each connector URL instead.
		#
		# Re-adding the connector is NOT enough to trigger this: claude.ai
		# rehydrates its stored grant for the same URL and never re-reads the
		# metadata. audience_whitelist below is narrowed to the slashed form
		# for the same reason — a cached bare-audience token has to start
		# failing before the client will re-discover. Revert both together.
		handle /.well-known/oauth-protected-resource {
			header Content-Type application/json
			respond `{"resource":"https://ebay.mcp.nickawilliams.com/","authorization_servers":["https://auth.nickawilliams.com/"],"bearer_methods_supported":["header"],"scopes_supported":["offline_access"]}` 200
		}

		# ebay-mcp serves its MCP endpoint at / (not /mcp), so no rewrite —
		# just collapse a stray /mcp back onto the root. Its express app also
		# skips the SDK's DNS-rebinding guard, so no Host header override is
		# needed either.
		#
		# Like supergateway (see the mail block), ebay-mcp answers
		# evicted/unknown MCP sessions with 400 where the spec requires 404 —
		# and only 404 tells clients to re-initialize, so a 400 wedges the
		# conversation. The blanket 400→404 mapping is slightly coarser here:
		# the SDK transport can also 400 a malformed body, which would read
		# back as a dead session — an extra re-initialize, not a wedge.
		@ebay-bearer header Authorization "Bearer {$MCP_TOKEN_EBAY}"
		handle @ebay-bearer {
			rewrite /mcp /
			rewrite /mcp/ /
			reverse_proxy ebay-mcp:8081 {
				@dead_session status 400
				handle_response @dead_session {
					header Content-Type application/json
					respond `{"jsonrpc":"2.0","error":{"code":-32001,"message":"Session not found"},"id":null}` 404
				}
			}
		}

		handle {
			jwtauth {
				jwk_url https://auth.nickawilliams.com/.well-known/jwks.json
				issuer_whitelist https://auth.nickawilliams.com/
				# TEMPORARY (2026-08-22): slashed form only, paired with the
				# probe in the metadata block above. Accepting both forms let
				# claude.ai keep using its cached bare-audience token, so
				# nothing ever 401'd and the client never re-read the
				# metadata — the probe could not fire. Dropping the bare form
				# makes that token fail, and handle_errors below answers with
				# the RFC 9728 discovery pointer, which is what drives a
				# re-authorization. Restore the bare form together with the
				# metadata block if the probe comes back bare.
				audience_whitelist https://ebay.mcp.nickawilliams.com/
			}
			rewrite /mcp /
			rewrite /mcp/ /
			reverse_proxy ebay-mcp:8081 {
				# Same 400→404 session translation as the bearer path above.
				@dead_session status 400
				handle_response @dead_session {
					header Content-Type application/json
					respond `{"jsonrpc":"2.0","error":{"code":-32001,"message":"Session not found"},"id":null}` 404
				}
			}
		}
	}

	# Unmatched subdomains: no OAuth metadata, just 404.
	handle {
		respond "Not Found" 404
	}

	# RFC 9728: a 401 must point the client at the protected-resource
	# metadata so it can discover the authorization server. {host} keeps it
	# correct per service under the wildcard.
	handle_errors {
		@unauthorized expression {http.error.status_code} == 401
		handle @unauthorized {
			header WWW-Authenticate `Bearer resource_metadata="https://{host}/.well-known/oauth-protected-resource"`
			respond "Unauthorized" 401
		}
	}
}
